# ---------------------------------------------------------------------------
# WafGuard AI — environment configuration
# Copy this file to `.env` in the project root and adjust as needed.
# ---------------------------------------------------------------------------

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=wafguard

# Dataset locations (see README "Dataset download instructions")
SECOM_DATA_PATH=./data/secom
WM811K_DATA_PATH=./data/wm811k
SYNTHETIC_DATA_PATH=./data/synthetic

# Trained model artifacts
MODEL_DIR=./backend/models/artifacts

# API server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string-before-any-real-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Optional LLM copilot (leave blank to use the deterministic, evidence-cited answer)
# LLM_PROVIDER: "" | "anthropic" | "openai_compatible" (any OpenAI-style endpoint via LLM_BASE_URL)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Experiment tracking (local SQLite store under this folder; set false to disable)
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=./mlruns

# Frontend (Vite). Leave as /api so the Vite/nginx proxy forwards to FastAPI
# (avoids cross-origin 401s). Set to http://localhost:8000/api only if the UI
# must call the API origin directly.
VITE_API_BASE_URL=/api
