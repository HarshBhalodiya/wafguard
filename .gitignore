data/secom/*
data/wm811k/*
data/synthetic/*
!data/secom/.gitkeep
!data/wm811k/.gitkeep
!data/synthetic/.gitkeep

# Trained model artifacts (regenerate via scripts/train_*.py)
backend/models/artifacts/*
